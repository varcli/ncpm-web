# NCPM Environment Configuration
# Copy this file to .env and modify as needed

# Published image. Set NCPM_VERSION to a yyyyMMdd tag to pin a release.
NCPM_IMAGE=ghcr.io/varcli/ncpm-web
NCPM_VERSION=latest

# Panel Configuration
Panel__Host=0.0.0.0
Panel__Port=8098

# Initial administrator. Leave the password empty to generate a random one in
# data/secrets/initial-admin-password. These values are used only when users.yml
# does not exist. Prefer NCPM_ADMIN_PASSWORD_FILE for Docker/Kubernetes secrets.
NCPM_ADMIN_USERNAME=admin
NCPM_ADMIN_PASSWORD=
NCPM_ADMIN_PASSWORD_FILE=

# Docker Configuration
# For local Docker (default)
Docker__Host=unix:///var/run/docker.sock

# For remote Docker via TCP
# Docker__Host=tcp://192.168.1.100:2375

# Persistent data. Relative paths are resolved from docker-compose.yml.
NCPM_DATA_PATH=./deploy/data

# For panel-managed Compose projects that use relative bind mounts, set the
# absolute host path corresponding to /app/data/compose.
# NCPM_COMPOSE_HOST_PATH=/opt/ncpm/data/compose

# Nginx Configuration
Nginx__ConfigPath=/etc/nginx
Nginx__ExecutablePath=nginx

# Security Configuration
Security__RequireAuth=true
Security__SessionTimeout=3600
Security__MaxLoginAttempts=5
Security__LockoutDuration=300

# Logging Configuration
Logging__Level=Information
Logging__Path=/app/data/logs
