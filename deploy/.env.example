# NCPM Environment Configuration
# Copy this file to .env and modify as needed

# Panel Configuration
Panel__Host=0.0.0.0
Panel__Port=8098

# Docker Configuration
# For local Docker (default)
Docker__Host=unix:///var/run/docker.sock

# For remote Docker via TCP
# Docker__Host=tcp://192.168.1.100:2375

# For remote Docker via SSH
# Docker__Host=ssh://user@192.168.1.100:22

# Nginx Configuration
Nginx__ConfigPath=/etc/nginx
Nginx__ExecutablePath=nginx

# Security Configuration
Security__RequireAuth=true
Security__SessionTimeout=3600
Security__MaxLoginAttempts=5
Security__LockoutDuration=300

# Logging Configuration
Logging__Level=Information
Logging__Path=/app/data/logs
