@namespace Ncpm
@inject NavigationManager Navigation

@code {
    protected override void OnAfterRender(bool firstRender)
    {
        // Navigation requires the interactive circuit. During server prerendering
        // the authentication provider cannot read browser local storage yet, so
        // redirecting from OnInitialized can trigger an unnecessary full reload
        // before the real client authentication state is known.
        if (firstRender)
            Navigation.NavigateTo("/login", replace: true);
    }
}
