@namespace Ncpm.Layouts
@inherits LayoutComponentBase
@using Microsoft.AspNetCore.Components.Authorization
@using Ncpm.Services
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager Navigation
@inject Ncpm.Services.ConfigService ConfigService

@* AuthorizeRouteView renders its NotAuthorized content inside this layout, so
   without this gate the whole workbench shell — sidebar, every menu entry, header —
   paints for an anonymous visitor while RedirectToLogin is still navigating away.
   AuthorizeView renders nothing until the state resolves, so there is no flash. *@
<AuthorizeView Context="auth">
    <Authorized>
        <AntDesign.ProLayout.BasicLayout
            Logo="@("/assets/logo.svg")"
            MenuData="_menuData"
            MenuAccordion
            @bind-Collapsed="collapsed">
            <HeaderContentRender>
                <Space Size="@("24")">
                    <SpaceItem>
                        <Icon Class="action" Type="@(collapsed?"menu-unfold":"menu-fold")" OnClick="Toggle" />
                    </SpaceItem>
                    <SpaceItem>
                        <Icon Class="action" Type="reload" Theme="@IconThemeType.Outline" OnClick="Reload" />
                    </SpaceItem>
                </Space>
            </HeaderContentRender>
            <RightContentRender>
                <Button Type="@ButtonType.Link" Icon="@IconType.Outline.Logout" OnClick="Logout">
                    退出登录
                </Button>
            </RightContentRender>
            <ChildContent>
                <ReuseTabs></ReuseTabs>
            </ChildContent>
            <FooterRender>
                <FooterView Copyright="@($"{DateTime.Now.Year} NCPM · Container & Proxy Control")" Links="Links"></FooterView>
            </FooterRender>
        </AntDesign.ProLayout.BasicLayout>

        <SettingDrawer />
    </Authorized>
    <NotAuthorized>
        @* Render Body without the workbench chrome. Body is whatever
           AuthorizeRouteView produced for the unauthorized case — RedirectToLogin,
           or the "no permission" notice — so the redirect still runs. Leaving this
           empty would close the bypass but strand the visitor on a blank page. *@
        @Body
    </NotAuthorized>
</AuthorizeView>

@code{
    bool collapsed;

    public LinkItem[] Links = [];

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        var state = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var mustChangePassword = state.User.HasClaim("ncpm:must_change_password", "true");
        var currentPath = Navigation.ToBaseRelativePath(Navigation.Uri)
            .Split('?', '#')[0]
            .Trim('/');
        if (mustChangePassword
            && !currentPath.Equals("settings/account", StringComparison.OrdinalIgnoreCase))
        {
            Navigation.NavigateTo("/settings/account", forceLoad: true);
        }
    }

    void Toggle()
    {
        collapsed = !collapsed;
    }

    async Task Logout()
    {
        if (AuthenticationStateProvider is AuthStateProvider provider)
            await provider.NotifyUserLogout();

        var requireAuth = ConfigService.LoadAppConfig().Security.RequireAuth;
        Navigation.NavigateTo(requireAuth ? "/login" : "/", forceLoad: true);
    }

}
