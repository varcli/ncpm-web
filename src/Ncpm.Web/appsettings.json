{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ProSettings": {
    "Title": "Ncpm",
    "Logo": "/logo.png",
    "NavTheme": "realDark",
    "Layout": "mix",
    "ContentWidth": "Fluid",
    "FixedHeader": true,
    "FixSiderbar": true,
    "ColorPrimary": "#1677FF",
    "ColorWeak": false,
    "SplitMenus": false,
    "HeaderRender": true,
    "FooterRender": true,
    "MenuRender": true,
    "MenuHeaderRender": true
  },
  "Config": {
    "Path": "data/config",
    "SecretsPath": "data/secrets"
  },
  "Panel": {
    "Host": "0.0.0.0",
    "Port": 8098,
    "BasePath": "/"
  },
  "Docker": {
    "Host": "unix:///var/run/docker.sock"
  },
  "Nginx": {
    "ConfigPath": "/etc/nginx",
    "GeneratedPath": "/app/data/nginx/generated",
    "ActivePath": "/app/data/nginx/active",
    "StreamPath": "/app/data/nginx/stream",
    "CertPath": "/app/data/certs",
    "ExecutablePath": "nginx"
  },
  "Security": {
    "RequireAuth": true,
    "SessionTimeout": 3600,
    "MaxLoginAttempts": 5,
    "LockoutDuration": 300
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "data/logs/ncpm-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30
        }
      }
    ]
  }
}
