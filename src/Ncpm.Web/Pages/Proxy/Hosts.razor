@page "/proxy/hosts"
@using Microsoft.AspNetCore.Authorization
@using Ncpm.Data
@using Ncpm.Services
@attribute [Authorize]
@inject Ncpm.Services.ConfigService ConfigService
@inject NginxService NginxService
@inject IMessageService Message

<PageHeader Title="反向代理" Subtitle="管理代理主机配置">
    <PageHeaderExtra>
        <Button Type="@ButtonType.Primary" Icon="@IconType.Outline.Plus" OnClick="OpenCreate">新建代理</Button>
    </PageHeaderExtra>
</PageHeader>

<Table TItem="ProxyHostConfig" DataSource="@_hosts" Loading="@_loading">
    <PropertyColumn Property="c => c.Id" Title="ID" Width="100" />
    <PropertyColumn Property="c => c.Scheme" Title="类型" Width="80">
        <Tag Color="@(context.Scheme == ProxyScheme.Http ? "blue" : context.Scheme == ProxyScheme.Tcp ? "orange" : context.Scheme == ProxyScheme.Udp ? "purple" : "green")">
            @DisplayText.ProxyScheme(context.Scheme)
        </Tag>
    </PropertyColumn>
    <PropertyColumn Property="c => c.Hosts" Title="域名">
        @foreach (var host in context.Hosts)
        {
            <Tag>@host</Tag>
        }
    </PropertyColumn>
    <PropertyColumn Property="c => c.Upstreams" Title="目标" Width="200">
        @foreach (var upstream in context.Upstreams.Take(2))
        {
            <Tag>@upstream.Url</Tag>
        }
        @if (context.Upstreams.Count > 2)
        {
            <Tag>+@(context.Upstreams.Count - 2)</Tag>
        }
    </PropertyColumn>
    <PropertyColumn Property="c => c.Tls.Mode" Title="TLS" Width="110">
        <Tag Color="@(context.Tls.Mode == TlsMode.Acme ? "green" : context.Tls.Mode == TlsMode.Manual ? "blue" : "default")">
            @DisplayText.TlsMode(context.Tls.Mode)
        </Tag>
    </PropertyColumn>
    <PropertyColumn Property="c => c.LoadBalance.Mode" Title="负载均衡" Width="100">
        @if (context.Upstreams.Count > 1)
        {
            <Tag>@DisplayText.LoadBalanceMode(context.LoadBalance.Mode)</Tag>
        }
        else
        {
            <span style="color: #999;">-</span>
        }
    </PropertyColumn>
    <PropertyColumn Property="c => c.Enabled" Title="状态" Width="80">
        <Tag Color="@(context.Enabled ? "green" : "red")">@(context.Enabled ? "启用" : "禁用")</Tag>
    </PropertyColumn>
    <ActionColumn Title="操作" Width="200">
        <Space>
            <SpaceItem><Button Type="@ButtonType.Link" Icon="@IconType.Outline.Edit" OnClick="@(() => OpenEdit(context))">编辑</Button></SpaceItem>
            <SpaceItem><Button Type="@ButtonType.Link" Icon="@IconType.Outline.Reload" OnClick="@(() => PublishHost(context))">发布</Button></SpaceItem>
            <SpaceItem><Popconfirm Title="确认删除此代理配置？" OnConfirm="@(() => DeleteHost(context))" OkText="确认" CancelText="取消">
                <Button Type="@ButtonType.Link" Danger Icon="@IconType.Outline.Delete">删除</Button>
            </Popconfirm></SpaceItem>
        </Space>
    </ActionColumn>
</Table>

@* Create/Edit Modal *@
<Modal Title="@(_isEditing ? "编辑代理" : "新建代理")" @bind-Visible="@_modalVisible" Width="900" OnOk="SaveHost" OnCancel="CloseModal">
    <Form Model="@_editHost" Layout="@FormLayout.Vertical">
        <Tabs DefaultActiveKey="basic">
            <TabPane Key="basic" Tab="基础">
                <FormItem Label="类型">
                    <Select @bind-Value="@_editHost.Scheme" TItem="ProxyScheme" TItemValue="ProxyScheme">
                        <SelectOptions>
                            <SelectOption TItem="ProxyScheme" TItemValue="ProxyScheme" Value="@ProxyScheme.Http" Label="HTTP 反向代理" />
                            <SelectOption TItem="ProxyScheme" TItemValue="ProxyScheme" Value="@ProxyScheme.Tcp" Label="TCP 代理" />
                            <SelectOption TItem="ProxyScheme" TItemValue="ProxyScheme" Value="@ProxyScheme.Udp" Label="UDP 代理" />
                            <SelectOption TItem="ProxyScheme" TItemValue="ProxyScheme" Value="@ProxyScheme.FileServer" Label="静态文件服务" />
                        </SelectOptions>
                    </Select>
                </FormItem>
                <FormItem Label="域名（每行一个）">
                    <TextArea Rows="3" @bind-Value="@_hostsText" Placeholder="app.example.com&#10;*.example.com" />
                </FormItem>
                @if (_editHost.Scheme == ProxyScheme.Tcp || _editHost.Scheme == ProxyScheme.Udp)
                {
                    <FormItem Label="监听端口">
                        <AntDesign.InputNumber @bind-Value="@_editHost.Http.ListenPort" Style="width: 100%" />
                    </FormItem>
                }
                <FormItem Label="启用">
                    <Switch @bind-Value="@_editHost.Enabled" />
                </FormItem>
            </TabPane>

            @if (_editHost.Scheme == ProxyScheme.Http || _editHost.Scheme == ProxyScheme.Https)
            {
                <TabPane Key="upstream" Tab="目标">
                    @foreach (var upstream in _editHost.Upstreams)
                    {
                        <Row Gutter="8" Style="margin-bottom: 8px;">
                            <AntDesign.Col Span="12">
                                <Input @bind-Value="@upstream.Url" Placeholder="http://localhost:3000" />
                            </AntDesign.Col>
                            <AntDesign.Col Span="4">
                                <AntDesign.InputNumber @bind-Value="@upstream.Weight" Min="1" Placeholder="权重" />
                            </AntDesign.Col>
                            <AntDesign.Col Span="4">
                                <Checkbox @bind-Value="@upstream.IsBackup">备用</Checkbox>
                            </AntDesign.Col>
                            <AntDesign.Col Span="4">
                                <Button Danger OnClick="@(() => _editHost.Upstreams.Remove(upstream))">删除</Button>
                            </AntDesign.Col>
                        </Row>
                    }
                    <Button Type="@ButtonType.Dashed" OnClick="@(() => _editHost.Upstreams.Add(new UpstreamConfig()))" Style="width: 100%;">
                        + 添加目标
                    </Button>

                    @if (_editHost.Upstreams.Count > 1)
                    {
                        <Divider>负载均衡</Divider>
                        <FormItem Label="均衡模式">
                            <Select @bind-Value="@_editHost.LoadBalance.Mode" TItem="LoadBalanceMode" TItemValue="LoadBalanceMode">
                                <SelectOptions>
                                    <SelectOption TItem="LoadBalanceMode" TItemValue="LoadBalanceMode" Value="@LoadBalanceMode.RoundRobin" Label="轮询 (Round Robin)" />
                                    <SelectOption TItem="LoadBalanceMode" TItemValue="LoadBalanceMode" Value="@LoadBalanceMode.LeastConn" Label="最少连接 (Least Conn)" />
                                    <SelectOption TItem="LoadBalanceMode" TItemValue="LoadBalanceMode" Value="@LoadBalanceMode.IpHash" Label="IP 哈希 (IP Hash)" />
                                </SelectOptions>
                            </Select>
                        </FormItem>
                        <FormItem Label="会话保持">
                            <Switch @bind-Value="@_editHost.LoadBalance.Sticky" />
                        </FormItem>
                    }
                </TabPane>
            }

            @if (_editHost.Scheme == ProxyScheme.FileServer)
            {
                <TabPane Key="fileserver" Tab="文件服务">
                    <FormItem Label="根目录">
                        <Input @bind-Value="@_editHost.Http.Root" Placeholder="/var/www/html" />
                    </FormItem>
                    <FormItem Label="SPA 模式">
                        <Switch @bind-Value="@_editHost.Http.Spa" />
                        <div style="color: #999; font-size: 12px;">启用后所有请求都会回退到 index.html</div>
                    </FormItem>
                    <FormItem Label="默认文件">
                        <Input @bind-Value="@_editHost.Http.Index" Placeholder="index.html" />
                    </FormItem>
                </TabPane>
            }

            <TabPane Key="tls" Tab="TLS">
                <FormItem Label="TLS 模式">
                    <Select @bind-Value="@_editHost.Tls.Mode" TItem="TlsMode" TItemValue="TlsMode">
                        <SelectOptions>
                            <SelectOption TItem="TlsMode" TItemValue="TlsMode" Value="@TlsMode.Off" Label="关闭" />
                            <SelectOption TItem="TlsMode" TItemValue="TlsMode" Value="@TlsMode.Manual" Label="手动证书" />
                            <SelectOption TItem="TlsMode" TItemValue="TlsMode" Value="@TlsMode.Acme" Label="ACME 自动证书" />
                        </SelectOptions>
                    </Select>
                </FormItem>
                @if (_editHost.Tls.Mode == TlsMode.Manual)
                {
                    <FormItem Label="证书路径">
                        <Input @bind-Value="@_editHost.Tls.CertPath" />
                    </FormItem>
                    <FormItem Label="密钥路径">
                        <Input @bind-Value="@_editHost.Tls.KeyPath" />
                    </FormItem>
                }
                @if (_editHost.Tls.Mode != TlsMode.Off)
                {
                    <FormItem Label="强制 HTTPS">
                        <Switch @bind-Value="@_editHost.Http.RedirectToHttps" />
                    </FormItem>
                }
                @if (_editHost.Tls.Mode != TlsMode.Off)
                {
                    <Divider>mTLS (双向 TLS)</Divider>
                    <FormItem Label="客户端 CA 证书路径">
                        <Input @bind-Value="@_mtlsCaPath" Placeholder="/path/to/ca.crt" />
                    </FormItem>
                    <FormItem Label="要求客户端证书">
                        <Switch @bind-Value="@_mtlsRequired" />
                    </FormItem>
                }
            </TabPane>

            <TabPane Key="http" Tab="HTTP">
                <Row Gutter="16">
                    <AntDesign.Col Span="12">
                        <FormItem Label="WebSocket 支持">
                            <Switch @bind-Value="@_editHost.Http.Websocket" />
                        </FormItem>
                    </AntDesign.Col>
                    <AntDesign.Col Span="12">
                        <FormItem Label="保留 Host 头">
                            <Switch @bind-Value="@_editHost.Http.PreserveHost" />
                        </FormItem>
                    </AntDesign.Col>
                </Row>
                <Row Gutter="16">
                    <AntDesign.Col Span="12">
                        <FormItem Label="连接超时">
                            <Input @bind-Value="@_editHost.Http.ConnectTimeout" Placeholder="30s" />
                        </FormItem>
                    </AntDesign.Col>
                    <AntDesign.Col Span="12">
                        <FormItem Label="响应超时">
                            <Input @bind-Value="@_editHost.Http.ResponseTimeout" Placeholder="60s" />
                        </FormItem>
                    </AntDesign.Col>
                </Row>
                <FormItem Label="缓冲">
                    <Switch @bind-Value="@_editHost.Http.Buffering" />
                </FormItem>
                @if (_editHost.Http.Buffering)
                {
                    <FormItem Label="缓冲大小">
                        <Input @bind-Value="@_editHost.Http.BufferSize" Placeholder="4k" />
                    </FormItem>
                }
            </TabPane>

            <TabPane Key="rules" Tab="规则">
                @foreach (var rule in _editHost.Rules)
                {
                    <Card Title="@($"规则: {rule.Name}")" Size="@CardSize.Small" Style="margin-bottom: 12px;">
                        <Row Gutter="8">
                            <AntDesign.Col Span="12">
                                <FormItem Label="名称">
                                    <Input @bind-Value="@rule.Name" />
                                </FormItem>
                            </AntDesign.Col>
                            <AntDesign.Col Span="6">
                                <FormItem Label="默认规则">
                                    <Switch @bind-Value="@rule.IsDefault" />
                                </FormItem>
                            </AntDesign.Col>
                        </Row>

                        <Divider>匹配条件</Divider>
                        @foreach (var condition in rule.Conditions)
                        {
                            <Row Gutter="8" Style="margin-bottom: 8px;">
                                <AntDesign.Col Span="6">
                                    <Select @bind-Value="@condition.Type" TItem="RuleMatchType" TItemValue="RuleMatchType">
                                        <SelectOptions>
                                            <SelectOption TItem="RuleMatchType" TItemValue="RuleMatchType" Value="@RuleMatchType.Path" Label="路径" />
                                            <SelectOption TItem="RuleMatchType" TItemValue="RuleMatchType" Value="@RuleMatchType.Header" Label="Header" />
                                            <SelectOption TItem="RuleMatchType" TItemValue="RuleMatchType" Value="@RuleMatchType.Method" Label="方法" />
                                            <SelectOption TItem="RuleMatchType" TItemValue="RuleMatchType" Value="@RuleMatchType.Host" Label="域名" />
                                            <SelectOption TItem="RuleMatchType" TItemValue="RuleMatchType" Value="@RuleMatchType.Query" Label="Query" />
                                            <SelectOption TItem="RuleMatchType" TItemValue="RuleMatchType" Value="@RuleMatchType.RemoteIp" Label="IP" />
                                        </SelectOptions>
                                    </Select>
                                </AntDesign.Col>
                                <AntDesign.Col Span="6">
                                    <Input @bind-Value="@condition.Key" Placeholder="键 (Header名等)" />
                                </AntDesign.Col>
                                <AntDesign.Col Span="8">
                                    <Input @bind-Value="@condition.Value" Placeholder="值" />
                                </AntDesign.Col>
                                <AntDesign.Col Span="2">
                                    <Checkbox @bind-Value="@condition.Negate">取反</Checkbox>
                                </AntDesign.Col>
                                <AntDesign.Col Span="2">
                                    <Button Danger Size="@ButtonSize.Small" OnClick="@(() => rule.Conditions.Remove(condition))">×</Button>
                                </AntDesign.Col>
                            </Row>
                        }
                        <Button Type="@ButtonType.Dashed" Size="@ButtonSize.Small" OnClick="@(() => rule.Conditions.Add(new RuleCondition()))" Style="width: 100%;">
                            + 添加条件
                        </Button>

                        <Divider>执行动作</Divider>
                        @foreach (var action in rule.Actions)
                        {
                            <Row Gutter="8" Style="margin-bottom: 8px;">
                                <AntDesign.Col Span="6">
                                    <Select @bind-Value="@action.Type" TItem="RuleActionType" TItemValue="RuleActionType">
                                        <SelectOptions>
                                            <SelectOption TItem="RuleActionType" TItemValue="RuleActionType" Value="@RuleActionType.Rewrite" Label="重写" />
                                            <SelectOption TItem="RuleActionType" TItemValue="RuleActionType" Value="@RuleActionType.Redirect" Label="重定向" />
                                            <SelectOption TItem="RuleActionType" TItemValue="RuleActionType" Value="@RuleActionType.Error" Label="错误" />
                                            <SelectOption TItem="RuleActionType" TItemValue="RuleActionType" Value="@RuleActionType.SetHeader" Label="设置Header" />
                                            <SelectOption TItem="RuleActionType" TItemValue="RuleActionType" Value="@RuleActionType.RemoveHeader" Label="删除Header" />
                                        </SelectOptions>
                                    </Select>
                                </AntDesign.Col>
                                <AntDesign.Col Span="6">
                                    <Input @bind-Value="@action.Key" Placeholder="键" />
                                </AntDesign.Col>
                                <AntDesign.Col Span="6">
                                    <Input @bind-Value="@action.Value" Placeholder="值" />
                                </AntDesign.Col>
                                <AntDesign.Col Span="4">
                                    <AntDesign.InputNumber @bind-Value="@action.StatusCode" Placeholder="状态码" />
                                </AntDesign.Col>
                                <AntDesign.Col Span="2">
                                    <Button Danger Size="@ButtonSize.Small" OnClick="@(() => rule.Actions.Remove(action))">×</Button>
                                </AntDesign.Col>
                            </Row>
                        }
                        <Button Type="@ButtonType.Dashed" Size="@ButtonSize.Small" OnClick="@(() => rule.Actions.Add(new RuleAction()))" Style="width: 100%;">
                            + 添加动作
                        </Button>
                    </Card>
                }
                <Button Type="@ButtonType.Dashed" OnClick="AddRule" Style="width: 100%;">
                    + 添加规则
                </Button>
            </TabPane>
        </Tabs>
    </Form>
</Modal>

@code {
    private List<ProxyHostConfig> _hosts = new();
    private bool _loading = true;
    private bool _modalVisible;
    private bool _isEditing;
    private ProxyHostConfig _editHost = new();
    private string _hostsText = string.Empty;
    private string _mtlsCaPath = string.Empty;
    private bool _mtlsRequired;

    protected override void OnInitialized()
    {
        LoadHosts();
    }

    private void LoadHosts()
    {
        _loading = true;
        _hosts = ConfigService.LoadProxyHosts();
        _loading = false;
    }

    private void OpenCreate()
    {
        _isEditing = false;
        _editHost = new ProxyHostConfig
        {
            Id = Guid.NewGuid().ToString("N")[..8],
            Tls = new TlsHostConfig(),
            Http = new HttpHostConfig(),
            LoadBalance = new LoadBalanceConfig(),
            Logging = new LoggingHostConfig { AccessLog = true, ErrorLog = true }
        };
        _hostsText = string.Empty;
        _mtlsCaPath = string.Empty;
        _mtlsRequired = false;
        _modalVisible = true;
    }

    private void OpenEdit(ProxyHostConfig host)
    {
        _isEditing = true;
        _editHost = host;
        _hostsText = string.Join("\n", host.Hosts);
        _mtlsCaPath = host.Mtls?.CaCertPath ?? string.Empty;
        _mtlsRequired = host.Mtls?.RequireClientCert ?? false;
        _modalVisible = true;
    }

    private void CloseModal()
    {
        _modalVisible = false;
    }

    private void SaveHost()
    {
        _editHost.Hosts = _hostsText.Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).ToList();
        _editHost.UpdatedAt = DateTime.UtcNow;

        // Sync mTLS
        if (!string.IsNullOrEmpty(_mtlsCaPath))
        {
            _editHost.Mtls = new MtlsConfig
            {
                CaCertPath = _mtlsCaPath,
                RequireClientCert = _mtlsRequired
            };
        }
        else
        {
            _editHost.Mtls = null;
        }

        ConfigService.SaveProxyHost(_editHost);

        if (!_isEditing)
            _hosts.Add(_editHost);

        _modalVisible = false;
        Message.Success(_isEditing ? "代理配置已更新" : "代理配置已创建");
    }

    private async Task PublishHost(ProxyHostConfig host)
    {
        try
        {
            var success = await NginxService.PublishConfigAsync(host);
            Message.Success(success ? "Nginx 配置已发布并重载" : "发布失败");
        }
        catch (Exception ex)
        {
            Message.Error($"发布失败: {ex.Message}");
        }
    }

    private void DeleteHost(ProxyHostConfig host)
    {
        ConfigService.DeleteProxyHost(host.Id);
        NginxService.DeleteConfig(host.Id);
        _hosts.Remove(host);
        Message.Success("代理配置已删除");
    }

    private void AddRule()
    {
        _editHost.Rules.Add(new RouteRule
        {
            Name = $"规则-{_editHost.Rules.Count + 1}",
            Conditions = new(),
            Actions = new()
        });
    }
}
