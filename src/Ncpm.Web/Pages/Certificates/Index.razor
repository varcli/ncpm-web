@page "/certificates"
@using Microsoft.AspNetCore.Authorization
@using Ncpm.Data
@using Ncpm.Services
@using System.Security.Cryptography.X509Certificates
@attribute [Authorize]
@inject Ncpm.Services.ConfigService ConfigService
@inject AcmeService AcmeService
@inject IMessageService Message

<PageHeader Title="SSL 证书" Subtitle="管理 SSL 证书">
    <PageHeaderExtra>
        <Button Type="@ButtonType.Primary" Icon="@IconType.Outline.Plus" OnClick="OpenUpload">导入证书</Button>
        <Button Icon="@IconType.Outline.SafetyCertificate" OnClick="OpenAcme">ACME 自动申请</Button>
    </PageHeaderExtra>
</PageHeader>

<Table TItem="CertificateConfig" DataSource="@_certificates" Loading="@_loading">
    <PropertyColumn Property="c => c.Domain" Title="域名">
        <a href="@($"https://{context.Domain}")" target="_blank">@context.Domain</a>
    </PropertyColumn>
    <PropertyColumn Property="c => c.Issuer" Title="颁发者" Width="120">
        @(string.IsNullOrWhiteSpace(context.Issuer) ? "未知" : context.Issuer)
    </PropertyColumn>
    <PropertyColumn Property="c => c.Source" Title="来源" Width="100">
        <Tag Color="@(context.Source == CertificateSource.Acme ? "green" : context.Source == CertificateSource.Manual ? "blue" : "orange")">
            @DisplayText.CertificateSource(context.Source)
        </Tag>
    </PropertyColumn>
    <PropertyColumn Property="c => c.NotBefore" Title="生效时间" Width="160">
        @context.NotBefore.ToString("yyyy-MM-dd HH:mm")
    </PropertyColumn>
    <PropertyColumn Property="c => c.NotAfter" Title="过期时间" Width="160">
        @context.NotAfter.ToString("yyyy-MM-dd HH:mm")
    </PropertyColumn>
    <PropertyColumn Property="c => c.IsExpired" Title="状态" Width="120">
        @if (context.IsExpired)
        {
            <Tag Color="@("red")">已过期</Tag>
        }
        else if (context.IsExpiringSoon)
        {
            <Tag Color="@("orange")">@context.DaysUntilExpiry 天后过期</Tag>
        }
        else
        {
            <Tag Color="@("green")">有效 (@context.DaysUntilExpiry 天)</Tag>
        }
    </PropertyColumn>
    <ActionColumn Title="操作" Width="180">
        <Space>
            @if (context.Source == CertificateSource.Acme)
            {
                <SpaceItem><Button Type="@ButtonType.Link" Icon="@IconType.Outline.Reload" OnClick="@(() => RenewCertificate(context))">续期</Button></SpaceItem>
            }
            <SpaceItem><Popconfirm Title="确认删除此证书？" OnConfirm="@(() => DeleteCertificate(context))" OkText="确认" CancelText="取消">
                <Button Type="@ButtonType.Link" Danger Icon="@IconType.Outline.Delete">删除</Button>
            </Popconfirm></SpaceItem>
        </Space>
    </ActionColumn>
</Table>

@* Upload Modal *@
<Modal Title="导入容器内证书" @bind-Visible="@_uploadVisible" OnOk="SaveUpload" OnCancel="CloseUpload">
    <Form Model="@_uploadCert" Layout="@FormLayout.Vertical">
        <FormItem Label="域名" Required>
            <Input @bind-Value="@_uploadCert.Domain" Placeholder="example.com" />
        </FormItem>
        <FormItem Label="证书文件路径">
            <Input @bind-Value="@_uploadCert.CertPath" Placeholder="/path/to/cert.pem" />
        </FormItem>
        <FormItem Label="私钥文件路径">
            <Input @bind-Value="@_uploadCert.KeyPath" Placeholder="/path/to/key.pem" />
        </FormItem>
    </Form>
</Modal>

@* ACME Modal *@
<Modal Title="ACME 自动申请证书" @bind-Visible="@_acmeVisible" Width="700" OnOk="IssueAcmeCert" OnCancel="CloseAcme">
    <Form Model="@_acmeConfig" Layout="@FormLayout.Vertical">
        <FormItem Label="邮箱" Required>
            <Input @bind-Value="@_acmeConfig.Email" Placeholder="admin@example.com" />
        </FormItem>
        <FormItem Label="域名（每行一个）" Required>
            <TextArea Rows="3" @bind-Value="@_acmeDomainsText" Placeholder="example.com&#10;*.example.com" />
        </FormItem>
        <FormItem Label="验证方式">
            <Select @bind-Value="@_acmeConfig.Challenge" TItem="AcmeChallengeType" TItemValue="AcmeChallengeType">
                <SelectOptions>
                    <SelectOption TItem="AcmeChallengeType" TItemValue="AcmeChallengeType" Value="@AcmeChallengeType.Http01" Label="HTTP-01（需80端口）" />
                    <SelectOption TItem="AcmeChallengeType" TItemValue="AcmeChallengeType" Value="@AcmeChallengeType.Dns01" Label="DNS-01（支持通配符与自动续期）" />
                </SelectOptions>
            </Select>
        </FormItem>
        @if (_acmeConfig.Challenge == AcmeChallengeType.Http01)
        {
            <Alert Type="@AlertType.Info" ShowIcon="true" Style="margin-bottom: 16px;"
                   Message="HTTP-01 自动签发"
                   Description="域名必须解析到本机，且公网 80 端口可访问。通配符证书请选择 DNS-01。" />
        }
        else
        {
            <Alert Type="@AlertType.Info" ShowIcon="true" Style="margin-bottom: 16px;"
                   Message="DNS-01 自动签发"
                   Description="NCPM 会通过 DNS API 自动创建和清理 TXT 记录，支持 *.example.com，并保存凭据用于无人值守续期。建议使用仅有 DNS 编辑权限的最小权限令牌。" />
        }
        @if (_acmeConfig.Challenge == AcmeChallengeType.Dns01)
        {
            <FormItem Label="DNS 提供商">
                <Select @bind-Value="@_acmeConfig.DnsProvider" TItem="string" TItemValue="string" Placeholder="选择 DNS 提供商">
                    <SelectOptions>
                        @foreach (var provider in AcmeService.GetDnsProviders())
                        {
                            <SelectOption TItem="string" TItemValue="string" Value="@provider.Name" Label="@provider.DisplayName" />
                        }
                    </SelectOptions>
                </Select>
            </FormItem>
            @if (!string.IsNullOrEmpty(_acmeConfig.DnsProvider))
            {
                var provider = AcmeService.GetDnsProviders().FirstOrDefault(p => p.Name == _acmeConfig.DnsProvider);
                if (provider != null)
                {
                    @foreach (var field in provider.Fields)
                    {
                        // Resolve the entry here rather than indexing inside the bind
                        // expression: FormItem feeds ValueExpression to
                        // FieldIdentifier.Create, which cannot evaluate a method call
                        // used as an index argument and throws while rendering.
                        var credential = _dnsCredentials[CredentialKey(provider.Name, field.Name)];
                        <FormItem Label="@field.DisplayName">
                            @if (field.Secret)
                            {
                                <InputPassword @bind-Value="@credential.Value" Placeholder="@field.Placeholder" />
                            }
                            else
                            {
                                <Input @bind-Value="@credential.Value" Placeholder="@field.Placeholder" />
                            }
                        </FormItem>
                    }
                }
            }
            <FormItem Label="DNS 传播等待（秒）">
                <AntDesign.InputNumber @bind-Value="@_acmeConfig.DnsPropagationSeconds" Min="0" Max="3600" />
                <div style="color: rgba(255,255,255,.45); margin-top: 4px;">0 表示由提供商适配器自动检测；DNS 生效较慢时可设置固定等待时间。</div>
            </FormItem>
        }
        <FormItem Label="CA 服务器">
            <Select @bind-Value="@_acmeConfig.CaDirUrl" TItem="string" TItemValue="string">
                <SelectOptions>
                    <SelectOption TItem="string" TItemValue="string" Value="@("https://acme-v02.api.letsencrypt.org/directory")" Label="Let's Encrypt (生产)" />
                    <SelectOption TItem="string" TItemValue="string" Value="@("https://acme-staging-v02.api.letsencrypt.org/directory")" Label="Let's Encrypt (测试)" />
                </SelectOptions>
            </Select>
        </FormItem>
        <FormItem Label="密钥类型">
            <Select @bind-Value="@_acmeConfig.CertificateKeyType" TItem="string" TItemValue="string">
                <SelectOptions>
                    <SelectOption TItem="string" TItemValue="string" Value="@("EC256")" Label="ECDSA P-256 (推荐)" />
                    <SelectOption TItem="string" TItemValue="string" Value="@("EC384")" Label="ECDSA P-384" />
                    <SelectOption TItem="string" TItemValue="string" Value="@("RS256")" Label="RSA 2048" />
                </SelectOptions>
            </Select>
        </FormItem>
    </Form>
</Modal>

@code {
    private List<CertificateConfig> _certificates = new();
    private bool _loading = true;

    // Upload
    private bool _uploadVisible;
    private CertificateConfig _uploadCert = new();

    // ACME
    private bool _acmeVisible;
    private AcmeConfig _acmeConfig = new();
    private string _acmeDomainsText = string.Empty;

    // Values are boxed in a class so each input binds to a plain property. Binding
    // straight at a dictionary entry would make ValueExpression an index expression,
    // which FieldIdentifier.Create rejects. Keyed by provider so switching providers
    // in the form keeps whatever was already typed for the others.
    private Dictionary<string, DnsCredentialValue> _dnsCredentials = new();

    private sealed class DnsCredentialValue
    {
        public string Value { get; set; } = string.Empty;
    }

    protected override void OnInitialized()
    {
        LoadCertificates();
    }

    private void LoadCertificates()
    {
        _loading = true;
        _certificates = ConfigService.LoadCertificates();
        _loading = false;
    }

    // Upload
    private void OpenUpload()
    {
        _uploadCert = new CertificateConfig
        {
            Id = Guid.NewGuid().ToString("N")[..8],
            Source = CertificateSource.Manual,
            CreatedAt = DateTime.UtcNow
        };
        _uploadVisible = true;
    }

    private void CloseUpload() => _uploadVisible = false;

    private void SaveUpload()
    {
        if (string.IsNullOrWhiteSpace(_uploadCert.Domain)
            || string.IsNullOrWhiteSpace(_uploadCert.CertPath)
            || string.IsNullOrWhiteSpace(_uploadCert.KeyPath))
        {
            Message.Warning("请填写域名、证书路径和私钥路径");
            return;
        }

        if (!File.Exists(_uploadCert.CertPath) || !File.Exists(_uploadCert.KeyPath))
        {
            Message.Error("证书或私钥文件不存在；路径必须是面板容器内可访问的路径");
            return;
        }

        try
        {
            using var parsed = X509Certificate2.CreateFromPemFile(_uploadCert.CertPath);
            _uploadCert.Issuer = parsed.GetNameInfo(X509NameType.SimpleName, forIssuer: true);
            _uploadCert.NotBefore = parsed.NotBefore.ToUniversalTime();
            _uploadCert.NotAfter = parsed.NotAfter.ToUniversalTime();
            _uploadCert.Domains = [_uploadCert.Domain];
        }
        catch (Exception ex)
        {
            Message.Error($"证书解析失败: {ex.Message}");
            return;
        }

        _certificates.Add(_uploadCert);
        ConfigService.SaveCertificates(_certificates);
        _uploadVisible = false;
        Message.Success("证书已导入");
    }

    // ACME
    private void OpenAcme()
    {
        _acmeConfig = new AcmeConfig
        {
            Challenge = AcmeChallengeType.Http01,
            CaDirUrl = "https://acme-v02.api.letsencrypt.org/directory",
            CertificateKeyType = "EC256"
        };
        _acmeDomainsText = string.Empty;
        _dnsCredentials = AcmeService.GetDnsProviders()
            .SelectMany(provider => provider.Fields.Select(field => CredentialKey(provider.Name, field.Name)))
            .ToDictionary(name => name, _ => new DnsCredentialValue(), StringComparer.Ordinal);
        _acmeVisible = true;
    }

    private void CloseAcme() => _acmeVisible = false;

    private async Task IssueAcmeCert()
    {
        if (string.IsNullOrEmpty(_acmeConfig.Email) || string.IsNullOrEmpty(_acmeDomainsText))
        {
            Message.Warning("请填写邮箱和域名");
            return;
        }

        _acmeConfig.Domains = _acmeDomainsText.Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).ToList();
        if (_acmeConfig.Challenge == AcmeChallengeType.Dns01)
        {
            var provider = AcmeService.GetDnsProviders()
                .FirstOrDefault(item => item.Name == _acmeConfig.DnsProvider);
            if (provider == null)
            {
                Message.Warning("请选择 DNS 提供商");
                return;
            }

            _acmeConfig.DnsCredentials = provider.Fields.ToDictionary(
                field => field.Name,
                field => _dnsCredentials[CredentialKey(provider.Name, field.Name)].Value,
                StringComparer.Ordinal);
        }
        else
        {
            _acmeConfig.DnsCredentials = new();
        }

        Message.Loading("正在申请证书...");
        var success = await AcmeService.IssueCertificateAsync(_acmeConfig);

        if (success)
        {
            Message.Success("证书申请成功");
            LoadCertificates();
            _acmeVisible = false;
        }
        else
        {
            Message.Error($"证书申请失败: {AcmeService.LastError ?? "请检查日志"}");
        }
    }

    // Renew
    private async Task RenewCertificate(CertificateConfig cert)
    {
        Message.Loading("正在续期证书...");
        var success = await AcmeService.RenewCertificateAsync(cert.Domain);
        if (success)
        {
            Message.Success("证书续期成功");
            LoadCertificates();
        }
        else
        {
            Message.Error($"证书续期失败: {AcmeService.LastError ?? "请检查日志"}");
        }
    }

    // Delete
    private void DeleteCertificate(CertificateConfig cert)
    {
        AcmeService.DeleteCertificateSecrets(cert);
        _certificates.Remove(cert);
        ConfigService.SaveCertificates(_certificates);
        Message.Success("证书已删除");
    }

    private static string CredentialKey(string provider, string field) => $"{provider}:{field}";
}
