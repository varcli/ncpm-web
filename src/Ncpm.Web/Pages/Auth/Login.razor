@page "/login"
@layout LoginLayout
@using Microsoft.AspNetCore.Components.Authorization
@using Ncpm.Data
@using Ncpm.Services
@inject AuthService AuthService
@inject NavigationManager Navigation
@inject IMessageService Message
@inject ILocalStorageService LocalStorage
@inject AuthenticationStateProvider AuthStateProvider
@inject Ncpm.Services.ConfigService ConfigService

<main class="login-shell">
    <section class="login-context" aria-label="NCPM 控制平面">
        <header class="login-brand">
            <img class="login-brand-mark" src="assets/ncpm-login-logo.png" alt="" aria-hidden="true" />
            <span>NCPM</span>
        </header>

        <div class="login-context-copy">
            <p>集中管理 Nginx 路由、TLS 证书与容器工作负载。</p>
        </div>

        <div class="login-topology" aria-hidden="true">
            <div class="login-node login-node-entry">
                <small>ENTRY</small>
                <strong>:443</strong>
                <span>TLS</span>
            </div>
            <i class="login-route login-route-in"></i>
            <div class="login-node login-node-core">
                <small>DATA PLANE</small>
                <strong>NGINX</strong>
                <span>ROUTING</span>
            </div>
            <i class="login-route login-route-out"></i>
            <div class="login-upstreams">
                <span><i></i>APP_01</span>
                <span><i></i>APP_02</span>
                <span><i></i>APP_03</span>
            </div>
        </div>

        <footer class="login-capabilities">
            <span><Icon Type="global" /> 反向代理</span>
            <span><Icon Type="safety-certificate" /> ACME / TLS</span>
            <span><Icon Type="container" /> Docker</span>
        </footer>
    </section>

    <section class="login-access">
        <div class="login-card">
            <header class="login-card-header">
                <div class="login-mobile-brand">
                    <img class="login-brand-mark" src="assets/ncpm-login-logo.png" alt="" aria-hidden="true" />
                    <strong>NCPM</strong>
                </div>
                <h2>登录控制面板</h2>
                <p>使用管理员凭据继续。</p>
            </header>

            <div class="login-form">
        <Form Model="@_loginRequest" OnFinish="HandleLogin">
                    <FormItem Class="login-form-item">
                        <span class="login-field-label">用户名</span>
                        <Input @bind-Value="@_loginRequest.Username"
                       Placeholder="用户名"
                       Size="@InputSize.Large"
                       Prefix="@(_userIcon)" />
                    </FormItem>
                    <FormItem Class="login-form-item">
                        <span class="login-field-label">密码</span>
                        <InputPassword @bind-Value="@_loginRequest.Password"
                               Placeholder="密码"
                               Size="@InputSize.Large"
                               Prefix="@(_lockIcon)" />
                    </FormItem>
                    <FormItem Class="login-submit-item">
                        <Button Class="login-submit"
                                Type="@ButtonType.Primary"
                        HtmlType="submit" 
                        Block 
                        Size="@ButtonSize.Large"
                        Loading="@_loading">
                            进入控制面板 <Icon Type="arrow-right" />
                        </Button>
                    </FormItem>
        </Form>
            </div>

            <aside class="login-first-run">
                <Icon Type="key" />
                <div>
                    <strong>首次登录</strong>
                    <p>账号由环境变量设置；若未指定密码，请读取 <code>data/secrets/initial-admin-password</code> 中的一次性凭据。</p>
                </div>
            </aside>

        </div>
    </section>
</main>

@code {
    private LoginRequest _loginRequest = new();
    private bool _loading;
    private RenderFragment _userIcon =@<Icon Type="user" />;
    private RenderFragment _lockIcon =@<Icon Type="lock" />;

    protected override void OnInitialized()
    {
        if (!ConfigService.LoadAppConfig().Security.RequireAuth)
            Navigation.NavigateTo("/", forceLoad: true);
    }

    private async Task HandleLogin()
    {
        if (string.IsNullOrWhiteSpace(_loginRequest.Username) || string.IsNullOrWhiteSpace(_loginRequest.Password))
        {
            Message.Warning("请输入用户名和密码");
            return;
        }

        _loading = true;
        try
        {
            var result = AuthService.Login(_loginRequest);
            if (result.Success)
            {
                await LocalStorage.SetItemAsStringAsync("auth_token", result.Token!);
                await LocalStorage.SetItemAsStringAsync("auth_user", result.User!.Username);

                // Notify auth state change
                ((AuthStateProvider)AuthStateProvider).NotifyUserAuthentication(result.Token!);

                Message.Success("登录成功");
                Navigation.NavigateTo(result.User.MustChangePassword ? "/settings/account" : "/");
            }
            else
            {
                Message.Error(result.ErrorMessage ?? "登录失败");
            }
        }
        catch (Exception ex)
        {
            Message.Error($"登录错误: {ex.Message}");
        }
        finally
        {
            _loading = false;
        }
    }
}
